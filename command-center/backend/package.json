{
  "name": "command-center-backend",
  "version": "1.0.0",
  "description": "Express + Socket.io brain for the Agentic AI Personal Assistant. Manages superpower child processes.",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "dev:python": "python listener.py",
    "dev:frontend": "cd .. && npm run dev",
    "jarvis": "concurrently -c \"cyan,green,magenta\" -n \"BACKEND,MIC,UI\" \"npm run dev\" \"npm run dev:python\" \"npm run dev:frontend\""
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "google-tts-api": "^2.0.2",
    "loudness": "^0.4.2",
    "mathjs": "^15.2.0",
    "node-fetch": "^3.3.2",
    "openai": "^7.4.0",
    "puppeteer": "^25.7.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.7.5",
    "sound-play": "^1.1.0",
    "whatsapp-web.js": "^1.34.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
